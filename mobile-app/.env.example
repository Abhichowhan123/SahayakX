# Web browser testing (default)
EXPO_PUBLIC_API_URL=http://localhost:80

# Android Emulator (AVD) — use this instead of localhost
# EXPO_PUBLIC_API_URL=http://10.0.2.2:80

# Real Android device on same WiFi — find your Mac IP with: ipconfig getifaddr en0
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:80
